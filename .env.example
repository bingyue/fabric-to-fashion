# Persistent disk required. Default: .data (never commit).
FABRIC_DATA_DIR=.data
# Optional: 64 hexadecimal characters. If absent, a mode-0600 key is generated in .data.
# FABRIC_ENCRYPTION_KEY=
# Optional password for a private deployment; protects the entire application.
# STUDIO_PASSWORD=
# APP_ORIGIN=https://studio.example.com
# COOKIE_SECURE=true
# Use HTTPS externally. For API gateways on loopback ONLY in local development:
# ALLOW_PRIVATE_API=false
# Optional comma separated allowlist for provider hosts:
# PROVIDER_HOST_ALLOWLIST=generativelanguage.googleapis.com,ark.cn-beijing.volces.com
